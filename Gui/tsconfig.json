{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2020"
    ],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020"
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/renderer/components",
    "src/renderer/stores",
    "src/renderer/styles",
    "src/renderer/App.tsx",
    "src/renderer/index.tsx"
  ],
  "include": [
    "src/main/**/*",
    "plugins/**/*",
    "src/renderer/types/**/*"
  ]
}