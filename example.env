# Playwright browser selection
# On Ubuntu 26.04 Playwright may not support downloading managed Chromium.
# Use system Chrome instead.
SARA_PLAYWRIGHT_CHANNEL=chrome
TELEGRAM_BOT_TOKEN = 

# ── Telegram ──────────────────────────────────────────────────────────────────
# Your personal Telegram chat ID (message @userinfobot to get it)
# TELEGRAM_CHAT_ID = 123456789

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Phone number with country code (used by pywhatkit)
# WHATSAPP_PHONE = +919876543210

# ── Discord ───────────────────────────────────────────────────────────────────
# Webhook URL: Discord → Channel Settings → Integrations → New Webhook
DISCORD_WEBHOOK_URL = 
DISCORD_BOT_TOKEN=





# ── Slack ─────────────────────────────────────────────────────────────────────
# Webhook URL: api.slack.com/apps → Your App → Incoming Webhooks
# SLACK_WEBHOOK_URL = https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Gmail (SMTP) ──────────────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your regular password
# Generate at: myaccount.google.com → Security → App Passwords
# EMAIL_SENDER   = yourgmail@gmail.com
# EMAIL_PASSWORD = your_app_password_here
# EMAIL_RECEIVER = default_receiver@gmail.com

# ── Groq Cloud (ultra-fast AI — Mixtral / Llama3) ─────────────────────────────
# Get your free API key at: https://console.groq.com
SARA_ALLOW_CLOUD_FALLBACK=true
GROQ_API_KEY=

# ── Claude AI (Anthropic — Premium Models) ────────────────────────────────────
# Get your API key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=your_api_key_here